# CivicLens Environment Configuration Example
# Copy this file to .env and configure for your deployment environment

# Application Environment (development | production)
ENVIRONMENT=development

# JWT Authentication Secret Key (REQUIRED: Set a strong random secret in production)
CIVICLENS_JWT_SECRET=your-secure-random-256-bit-secret-key-here

# Default Initial Administrator Seed Credentials (Used only on first database initialization)
CIVICLENS_ADMIN_EMAIL=admin@yourmunicipality.gov
CIVICLENS_ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Frontend Map Default Coordinates (Configurable municipal center)
VITE_MAP_CENTER_LAT=12.9165
VITE_MAP_CENTER_LNG=79.1325
VITE_MAP_DEFAULT_ZOOM=12
